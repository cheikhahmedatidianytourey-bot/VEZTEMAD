NODE_ENV=development
PORT=3000
# PostgreSQL connection string. Required for accounts and persistent projects.
DATABASE_URL=
# Generate a unique random secret of at least 32 characters.
JWT_SECRET=
# OpenAI-compatible chat completions endpoint and key.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai-compatible
# Optional integrations (not active until their adapters are implemented).
GITHUB_TOKEN=
RENDER_API_KEY=
ALLOWED_ORIGIN=
PG_POOL_MAX=10
